<?xml version="1.0" encoding="utf-8"?>

<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        tools:context=".PlayerActivity">

        <!-- ===================================================== -->
        <!-- MAIN PLAYER                                           -->
        <!-- ===================================================== -->

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:keepScreenOn="true"

            app:surface_type="texture_view"
            app:played_color="@color/color_primary"
            app:buffered_color="@android:color/darker_gray"

            app:show_subtitle_button="true"
            app:show_buffering="when_playing"

            app:controller_layout_id="@layout/custom_control"
            app:keep_content_on_player_reset="true" />

        <!-- ===================================================== -->
        <!-- CHANNEL OSD                                            -->
        <!-- ===================================================== -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/channel_osd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_channel_osd"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:elevation="10dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_channel_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="101"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="ANTARA TV"
                app:layout_constraintStart_toEndOf="@id/tv_channel_number"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===================================================== -->
        <!-- MINI CHANNEL PANEL                                     -->
        <!-- ===================================================== -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mini_channel_panel"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mini_channel_panel"
            android:elevation="20dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mini_channel_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===================================================== -->
        <!-- MINI CHANNEL TOGGLE                                    -->
        <!-- ===================================================== -->

        <ImageButton
            android:id="@+id/btn_mini_channel_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="18dp"
            android:background="@android:color/transparent"
            android:contentDescription="Channels"
            android:padding="10dp"
            android:src="@drawable/ic_list"
            android:tint="@android:color/white"
            android:elevation="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- ===================================================== -->
        <!-- LOCK OVERLAY                                           -->
        <!-- ===================================================== -->

        <FrameLayout
            android:id="@+id/lock_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:elevation="40dp">

            <ImageButton
                android:id="@+id/btn_unlock"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:contentDescription="Unlock controls"
                android:padding="10dp"
                android:src="@drawable/ic_lock"
                android:tint="@android:color/white" />

        </FrameLayout>

        <!-- ===================================================== -->
        <!-- LOCK BUTTON                                            -->
        <!-- ===================================================== -->

        <ImageButton
            android:id="@+id/btn_lock_overlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="18dp"
            android:background="@android:color/transparent"
            android:contentDescription="Lock controls"
            android:padding="10dp"
            android:src="@drawable/ic_lock"
            android:tint="@android:color/white"
            android:elevation="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
